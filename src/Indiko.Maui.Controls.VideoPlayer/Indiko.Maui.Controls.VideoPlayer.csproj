<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
		<!-- Local iOS builds: -p:IndikoIosSdk26=true pins the TFM to net10.0-ios26.0,
		     which selects the Microsoft.iOS.Sdk 26.0 pack and so Xcode 26.0 instead of the
		     27.1 the installed workload otherwise demands. The iOS SDK pins an exact Xcode
		     major.minor and a newer Xcode does not satisfy it. Opt-in, so CI keeps building
		     plain net10.0-ios. ValidateXcodeVersion=false is never the answer: it only moves
		     the failure into the trimmer. Build with:
		       export DEVELOPER_DIR=/Applications/Xcode-26.0.0.app/Contents/Developer
		       dotnet build ... -p:IndikoIosSdk26=true -f net10.0-ios26.0 -->
		<TargetFrameworks Condition="'$(IndikoIosSdk26)' == 'true'">net10.0-android;net10.0-ios26.0</TargetFrameworks>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!--
		  iOS 15 and Android 30 are the floor on purpose: a UI control has no
		  business raising the minimum OS of the apps that consume it. APIs newer
		  than this (AVPlayer.DefaultRate, iOS 16) are guarded at runtime.
		-->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">30.0</SupportedOSPlatformVersion>

		<!--
		  Pinned rather than inherited from the build machine's workload. With
		  Version="$(MauiVersion)" the published dependency would be whatever MAUI
		  happened to be installed when the package was packed, which silently
		  raises the floor for every consumer. 10.0.110 is the minimum this code
		  needs; NuGet resolves higher versions in the consuming app as usual.
		-->
		<MauiVersion>10.0.110</MauiVersion>

		<!-- NuGet -->
		<Authors>INDIKO</Authors>
		<Copyright>Copyright © INDIKO and contributors</Copyright>
		<IsPackable>True</IsPackable>
		<PackageProjectUrl>https://github.com/0xc3u/Indiko.Maui.Controls.VideoPlayer</PackageProjectUrl>
		<RepositoryUrl>https://github.com/0xc3u/Indiko.Maui.Controls.VideoPlayer</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>dotnet-maui;maui;ui;video;player;avplayer;media3;exoplayer;android;ios</PackageTags>
		<PackageReleaseNotes>https://github.com/0xc3u/Indiko.Maui.Controls.VideoPlayer/blob/main/CHANGELOG.md</PackageReleaseNotes>
		<IncludeSymbols>True</IncludeSymbols>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Title>INDIKO .NET MAUI Video Player</Title>
		<Description>Native video control for .NET MAUI built for analysis rather than viewing: frame-accurate seeking, frame-by-frame stepping, slow motion from 0.25x, and position events at 10-30 Hz for driving a map or timeline. Plays several files as one timeline (camera chapters), and plays by reference without copying - file paths, iOS photo-library assets and security-scoped bookmarks, Android content URIs. AVFoundation on iOS, Media3 ExoPlayer on Android, no system playback UI.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<None Include="icon.png" Pack="true" PackagePath="" />
		<None Include="..\..\README.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<!--
	  Media3 1.8.0 rather than the newest 1.11.1: from 1.9 onwards Media3 depends
	  on AndroidX Lifecycle 2.11 and Collection 1.6, which sit outside the
	  constraints of the Lifecycle 2.9 packages that MAUI 10.0.110 brings. That
	  mix builds, but it emits 18-21 NU1608 warnings in every consuming app and
	  leaves the AndroidX graph resolved against versions no one chose. 1.8.0
	  resolves cleanly (zero NU1605/NU1608) and is also the release that added
	  scrubbing mode, which this control uses. Raise it when MAUI's own graph
	  moves to Lifecycle 2.11.
	-->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" Version="1.8.0" />
		<PackageReference Include="Xamarin.AndroidX.Media3.UI" Version="1.8.0" />
	</ItemGroup>

</Project>
