<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!--
	  The timeline logic is compiled into the test assembly instead of being
	  referenced, so the tests run on a plain net10.0 SDK with no MAUI workload
	  and no iOS/Android platform packs. That is what lets `dotnet test` be the
	  first thing in the loop: a test run that needed the workloads would be as
	  slow and as fragile as the device build it is meant to come before.
	  The files under Timeline/ must therefore stay free of MAUI and platform
	  types; anything that touches AVFoundation or Media3 belongs in Platforms/.
	-->
	<ItemGroup>
		<Compile Include="..\..\src\Indiko.Maui.Controls.VideoPlayer\Timeline\**\*.cs"
		         Link="Timeline\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
	</ItemGroup>

</Project>
